// Seed data RKG SPM Kesehatan - anotasi awal. Belum merupakan hasil evaluasi model.

// Jalankan blok secara bertahap di Neo4j 5.x.

CREATE CONSTRAINT regulation_id IF NOT EXISTS FOR (r:Regulation) REQUIRE r.id IS UNIQUE;

CREATE CONSTRAINT norm_id IF NOT EXISTS FOR (n:Norm) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT actor_id IF NOT EXISTS FOR (a:Actor) REQUIRE a.id IS UNIQUE;

CREATE CONSTRAINT provision_id IF NOT EXISTS FOR (p:Provision) REQUIRE p.id IS UNIQUE;

CREATE CONSTRAINT service_id IF NOT EXISTS FOR (s:HealthService) REQUIRE s.id IS UNIQUE;

UNWIND [{id: 'R01', title: 'UUD NRI Tahun 1945 dalam satu naskah', type: 'Konstitusi', year: 1945, source_url: 'https://www.mpr.go.id/uploads/jdih/UUD_1945_DALAM_SATU_NASKAH.pdf', status_note: 'Konstitusi; sumber resmi MPR'}, {id: 'R02', title: 'UU No. 23 Tahun 2014 tentang Pemerintahan Daerah', type: 'Undang-undang', year: 2014, source_url: 'https://jdih.kemenkeu.go.id/api/download/fulltext/2014/23TAHUN2014UU.htm', status_note: 'Teks dasar resmi; wajib memperhatikan perubahan/putusan terkait'}, {id: 'R03', title: 'UU No. 17 Tahun 2023 tentang Kesehatan', type: 'Undang-undang', year: 2023, source_url: 'https://p2.kemkes.go.id/wp-content/uploads/2024/08/Undang-undang-Republik-Indonesia-Nomor-17-Tahun-2023-tentang-Kesehatan.pdf', status_note: 'Salinan resmi di domain Kementerian Kesehatan'}, {id: 'R04', title: 'PP No. 2 Tahun 2018 tentang Standar Pelayanan Minimal', type: 'Peraturan Pemerintah', year: 2018, source_url: 'https://www.peraturan.go.id/files/pp2-2018bt.pdf', status_note: 'Teks resmi peraturan.go.id'}, {id: 'R05', title: 'Permendagri No. 59 Tahun 2021 tentang Penerapan SPM', type: 'Peraturan Menteri', year: 2021, source_url: 'https://peraturan.go.id/files/bn1419-2021.pdf', status_note: 'Berita Negara No. 1419 tahun 2021'}, {id: 'R06', title: 'Permenkes No. 6 Tahun 2024 tentang Standar Teknis Pemenuhan SPM Kesehatan', type: 'Peraturan Menteri', year: 2024, source_url: 'https://www.peraturan.go.id/files/permenkes-no-6-tahun-2024.pdf', status_note: 'Berlaku menurut JDIH Kemenkes; mencabut Permenkes 4/2019'}, {id: 'R07', title: 'Perpres No. 13 Tahun 2026 tentang Pengelolaan Kesehatan', type: 'Peraturan Presiden', year: 2026, source_url: 'https://jdih.kemkes.go.id/storage/documents/pdfs/2026perpres013.pdf', status_note: 'Berlaku sejak 11 Maret 2026; mencabut Perpres 72/2012; regulasi pendukung, bukan khusus SPM'}] AS row
MERGE (v:Regulation {id:row.id})
SET v.title = row.title, v.type = row.type, v.year = row.year, v.source_url = row.source_url, v.status_note = row.status_note;

UNWIND [{id: 'A_NEGARA', name: 'Negara', category: 'KONSTITUSIONAL', note: 'Entitas negara bukan sinonim Pemerintah Daerah'}, {id: 'A_SETIAP_ORANG', name: 'Setiap orang', category: 'PEMEGANG_HAK', note: 'Hak konstitusi mencakup setiap orang'}, {id: 'A_WARGA', name: 'Warga negara', category: 'PEMEGANG_HAK', note: 'Definisi SPM menggunakan Warga Negara'}, {id: 'A_DAERAH_GOV', name: 'Pemerintahan daerah provinsi/kabupaten/kota', category: 'PEMERINTAHAN', note: 'Mencakup penyelenggaraan pemerintahan daerah; beda dari kepala daerah'}, {id: 'A_PUSAT', name: 'Pemerintah Pusat', category: 'PEMERINTAH', note: 'Aktor eksekutif tingkat nasional'}, {id: 'A_PEMDA_UMUM', name: 'Pemerintah Daerah (umum)', category: 'PEMERINTAH', note: 'Jangan asumsikan satu jenis layanan atau satu level'}, {id: 'A_PROV', name: 'Pemerintah Daerah Provinsi', category: 'PEMERINTAH', note: 'Level provinsi'}, {id: 'A_KABKOTA', name: 'Pemerintah Daerah Kabupaten/Kota', category: 'PEMERINTAH', note: 'Level kabupaten/kota'}, {id: 'A_DESA', name: 'Pemerintah Desa', category: 'PEMERINTAH', note: 'Disebut Perpres 13/2026; tidak otomatis wajib SPM 6/2024'}, {id: 'A_PERANGKAT', name: 'Perangkat Daerah', category: 'UNIT_ORGANISASI', note: 'Perangkat daerah sebagai pelaksana teknis daerah'}, {id: 'A_GUBERNUR', name: 'Gubernur', category: 'PEJABAT', note: 'Jabatan kepala daerah provinsi; berperan juga wakil pusat pada konteks tertentu'}, {id: 'A_BUPATI_WALIKOTA', name: 'Bupati/Wali Kota', category: 'PEJABAT', note: 'Jabatan kepala daerah kabupaten/kota'}, {id: 'A_MENKES', name: 'Menteri Kesehatan', category: 'PEJABAT', note: 'Menteri teknis sektor kesehatan'}, {id: 'A_MENDAGRI', name: 'Menteri Dalam Negeri', category: 'PEJABAT', note: 'Menteri teknis penerapan SPM secara umum'}, {id: 'A_TENAGA', name: 'Tenaga Medis/Tenaga Kesehatan', category: 'PELAKSANA_LAYANAN', note: 'Pelaksana teknis pelayanan, bukan pemerintah daerah'}] AS row
MERGE (v:Actor {id:row.id})
SET v.name = row.name, v.category = row.category, v.note = row.note;

UNWIND [{id: 'L01', name: 'Krisis kesehatan bencana dan/atau potensi bencana daerah provinsi', spm_level: 'PROVINSI', source_ref: 'R06 Pasal 2 ayat (3) huruf a'}, {id: 'L02', name: 'Kondisi kejadian luar biasa daerah provinsi', spm_level: 'PROVINSI', source_ref: 'R06 Pasal 2 ayat (3) huruf b'}, {id: 'L03', name: 'Pelayanan kesehatan ibu hamil', spm_level: 'KABUPATEN_KOTA', source_ref: 'R06 Pasal 2 ayat (4) huruf a'}, {id: 'L04', name: 'Pelayanan kesehatan ibu bersalin', spm_level: 'KABUPATEN_KOTA', source_ref: 'R06 Pasal 2 ayat (4) huruf b'}, {id: 'L05', name: 'Pelayanan kesehatan bayi baru lahir', spm_level: 'KABUPATEN_KOTA', source_ref: 'R06 Pasal 2 ayat (4) huruf c'}, {id: 'L06', name: 'Pelayanan kesehatan balita', spm_level: 'KABUPATEN_KOTA', source_ref: 'R06 Pasal 2 ayat (4) huruf d'}, {id: 'L07', name: 'Pelayanan kesehatan usia pendidikan dasar', spm_level: 'KABUPATEN_KOTA', source_ref: 'R06 Pasal 2 ayat (4) huruf e'}, {id: 'L08', name: 'Pelayanan kesehatan usia produktif', spm_level: 'KABUPATEN_KOTA', source_ref: 'R06 Pasal 2 ayat (4) huruf f'}, {id: 'L09', name: 'Pelayanan kesehatan usia lanjut', spm_level: 'KABUPATEN_KOTA', source_ref: 'R06 Pasal 2 ayat (4) huruf g'}, {id: 'L10', name: 'Pelayanan kesehatan penderita hipertensi', spm_level: 'KABUPATEN_KOTA', source_ref: 'R06 Pasal 2 ayat (4) huruf h'}, {id: 'L11', name: 'Pelayanan kesehatan penderita diabetes melitus', spm_level: 'KABUPATEN_KOTA', source_ref: 'R06 Pasal 2 ayat (4) huruf i'}, {id: 'L12', name: 'Pelayanan kesehatan orang dengan gangguan jiwa berat', spm_level: 'KABUPATEN_KOTA', source_ref: 'R06 Pasal 2 ayat (4) huruf j'}, {id: 'L13', name: 'Pelayanan kesehatan orang terduga tuberkulosis', spm_level: 'KABUPATEN_KOTA', source_ref: 'R06 Pasal 2 ayat (4) huruf k'}, {id: 'L14', name: 'Pelayanan kesehatan orang berisiko terinfeksi HIV', spm_level: 'KABUPATEN_KOTA', source_ref: 'R06 Pasal 2 ayat (4) huruf l'}] AS row
MERGE (v:HealthService {id:row.id})
SET v.name = row.name, v.spm_level = row.spm_level, v.source_ref = row.source_ref;

UNWIND [{id: 'R01::Pasal 18 ayat (2)', reg_id: 'R01', ref: 'Pasal 18 ayat (2)', source_url: 'https://www.mpr.go.id/uploads/jdih/UUD_1945_DALAM_SATU_NASKAH.pdf'}, {id: 'R01::Pasal 18A ayat (1)', reg_id: 'R01', ref: 'Pasal 18A ayat (1)', source_url: 'https://www.mpr.go.id/uploads/jdih/UUD_1945_DALAM_SATU_NASKAH.pdf'}, {id: 'R01::Pasal 18A ayat (2)', reg_id: 'R01', ref: 'Pasal 18A ayat (2)', source_url: 'https://www.mpr.go.id/uploads/jdih/UUD_1945_DALAM_SATU_NASKAH.pdf'}, {id: 'R01::Pasal 28H ayat (1)', reg_id: 'R01', ref: 'Pasal 28H ayat (1)', source_url: 'https://www.mpr.go.id/uploads/jdih/UUD_1945_DALAM_SATU_NASKAH.pdf'}, {id: 'R01::Pasal 34 ayat (3)', reg_id: 'R01', ref: 'Pasal 34 ayat (3)', source_url: 'https://www.mpr.go.id/uploads/jdih/UUD_1945_DALAM_SATU_NASKAH.pdf'}, {id: 'R02::Pasal 12 ayat (1) huruf b', reg_id: 'R02', ref: 'Pasal 12 ayat (1) huruf b', source_url: 'https://jdih.kemenkeu.go.id/api/download/fulltext/2014/23TAHUN2014UU.htm'}, {id: 'R02::Pasal 18 ayat (1)', reg_id: 'R02', ref: 'Pasal 18 ayat (1)', source_url: 'https://jdih.kemenkeu.go.id/api/download/fulltext/2014/23TAHUN2014UU.htm'}, {id: 'R02::Pasal 18 ayat (2)', reg_id: 'R02', ref: 'Pasal 18 ayat (2)', source_url: 'https://jdih.kemenkeu.go.id/api/download/fulltext/2014/23TAHUN2014UU.htm'}, {id: 'R03::Pasal 15', reg_id: 'R03', ref: 'Pasal 15', source_url: 'https://p2.kemkes.go.id/wp-content/uploads/2024/08/Undang-undang-Republik-Indonesia-Nomor-17-Tahun-2023-tentang-Kesehatan.pdf'}, {id: 'R03::Pasal 19 ayat (2) huruf e', reg_id: 'R03', ref: 'Pasal 19 ayat (2) huruf e', source_url: 'https://p2.kemkes.go.id/wp-content/uploads/2024/08/Undang-undang-Republik-Indonesia-Nomor-17-Tahun-2023-tentang-Kesehatan.pdf'}, {id: 'R03::Pasal 19 ayat (3) huruf b', reg_id: 'R03', ref: 'Pasal 19 ayat (3) huruf b', source_url: 'https://p2.kemkes.go.id/wp-content/uploads/2024/08/Undang-undang-Republik-Indonesia-Nomor-17-Tahun-2023-tentang-Kesehatan.pdf'}, {id: 'R07::Pasal 21 ayat (1)', reg_id: 'R07', ref: 'Pasal 21 ayat (1)', source_url: 'https://jdih.kemkes.go.id/storage/documents/pdfs/2026perpres013.pdf'}, {id: 'R07::Pasal 22 ayat (1)', reg_id: 'R07', ref: 'Pasal 22 ayat (1)', source_url: 'https://jdih.kemkes.go.id/storage/documents/pdfs/2026perpres013.pdf'}, {id: 'R04::Pasal 2', reg_id: 'R04', ref: 'Pasal 2', source_url: 'https://www.peraturan.go.id/files/pp2-2018bt.pdf'}, {id: 'R04::Pasal 6 ayat (2) huruf b', reg_id: 'R04', ref: 'Pasal 6 ayat (2) huruf b', source_url: 'https://www.peraturan.go.id/files/pp2-2018bt.pdf'}, {id: 'R04::Pasal 6 ayat (3) huruf a', reg_id: 'R04', ref: 'Pasal 6 ayat (3) huruf a', source_url: 'https://www.peraturan.go.id/files/pp2-2018bt.pdf'}, {id: 'R05::Pasal 4 huruf a-d', reg_id: 'R05', ref: 'Pasal 4 huruf a-d', source_url: 'https://peraturan.go.id/files/bn1419-2021.pdf'}, {id: 'R05::Pasal 5 ayat (1) huruf a', reg_id: 'R05', ref: 'Pasal 5 ayat (1) huruf a', source_url: 'https://peraturan.go.id/files/bn1419-2021.pdf'}, {id: 'R05::Pasal 5 ayat (1) huruf b', reg_id: 'R05', ref: 'Pasal 5 ayat (1) huruf b', source_url: 'https://peraturan.go.id/files/bn1419-2021.pdf'}, {id: 'R05::Pasal 5 ayat (2)', reg_id: 'R05', ref: 'Pasal 5 ayat (2)', source_url: 'https://peraturan.go.id/files/bn1419-2021.pdf'}, {id: 'R06::Pasal 2 ayat (1)', reg_id: 'R06', ref: 'Pasal 2 ayat (1)', source_url: 'https://www.peraturan.go.id/files/permenkes-no-6-tahun-2024.pdf'}, {id: 'R06::Pasal 2 ayat (3) huruf b', reg_id: 'R06', ref: 'Pasal 2 ayat (3) huruf b', source_url: 'https://www.peraturan.go.id/files/permenkes-no-6-tahun-2024.pdf'}, {id: 'R06::Pasal 2 ayat (4) huruf a', reg_id: 'R06', ref: 'Pasal 2 ayat (4) huruf a', source_url: 'https://www.peraturan.go.id/files/permenkes-no-6-tahun-2024.pdf'}, {id: 'R06::Pasal 3 ayat (1)', reg_id: 'R06', ref: 'Pasal 3 ayat (1)', source_url: 'https://www.peraturan.go.id/files/permenkes-no-6-tahun-2024.pdf'}, {id: 'R06::Pasal 4 ayat (1)', reg_id: 'R06', ref: 'Pasal 4 ayat (1)', source_url: 'https://www.peraturan.go.id/files/permenkes-no-6-tahun-2024.pdf'}, {id: 'R06::Pasal 5 ayat (1)', reg_id: 'R06', ref: 'Pasal 5 ayat (1)', source_url: 'https://www.peraturan.go.id/files/permenkes-no-6-tahun-2024.pdf'}, {id: 'R06::Pasal 5 ayat (2)', reg_id: 'R06', ref: 'Pasal 5 ayat (2)', source_url: 'https://www.peraturan.go.id/files/permenkes-no-6-tahun-2024.pdf'}, {id: 'R01::Pasal 18 ayat (5)', reg_id: 'R01', ref: 'Pasal 18 ayat (5)', source_url: 'https://www.mpr.go.id/uploads/jdih/UUD_1945_DALAM_SATU_NASKAH.pdf'}, {id: 'R02::Pasal 18 ayat (3)', reg_id: 'R02', ref: 'Pasal 18 ayat (3)', source_url: 'https://jdih.kemenkeu.go.id/api/download/fulltext/2014/23TAHUN2014UU.htm'}, {id: 'R04::Pasal 6 ayat (6)', reg_id: 'R04', ref: 'Pasal 6 ayat (6)', source_url: 'https://www.peraturan.go.id/files/pp2-2018bt.pdf'}, {id: 'R04::Pasal 16', reg_id: 'R04', ref: 'Pasal 16', source_url: 'https://www.peraturan.go.id/files/pp2-2018bt.pdf'}, {id: 'R06::Pasal 6', reg_id: 'R06', ref: 'Pasal 6', source_url: 'https://www.peraturan.go.id/files/permenkes-no-6-tahun-2024.pdf'}, {id: 'R07::Pasal 21 ayat (4)', reg_id: 'R07', ref: 'Pasal 21 ayat (4)', source_url: 'https://jdih.kemkes.go.id/storage/documents/pdfs/2026perpres013.pdf'}, {id: 'R03::Pasal 19 ayat (1)', reg_id: 'R03', ref: 'Pasal 19 ayat (1)', source_url: 'https://p2.kemkes.go.id/wp-content/uploads/2024/08/Undang-undang-Republik-Indonesia-Nomor-17-Tahun-2023-tentang-Kesehatan.pdf'}, {id: 'R05::Pasal 5 ayat (4)', reg_id: 'R05', ref: 'Pasal 5 ayat (4)', source_url: 'https://peraturan.go.id/files/bn1419-2021.pdf'}, {id: 'R04::Pasal 1 angka 1', reg_id: 'R04', ref: 'Pasal 1 angka 1', source_url: 'https://www.peraturan.go.id/files/pp2-2018bt.pdf'}, {id: 'R04::Pasal 19 ayat (4)', reg_id: 'R04', ref: 'Pasal 19 ayat (4)', source_url: 'https://www.peraturan.go.id/files/pp2-2018bt.pdf'}, {id: 'R06::Pasal 2 ayat (5)', reg_id: 'R06', ref: 'Pasal 2 ayat (5)', source_url: 'https://www.peraturan.go.id/files/permenkes-no-6-tahun-2024.pdf'}, {id: 'R06::Pasal 2 ayat (6)', reg_id: 'R06', ref: 'Pasal 2 ayat (6)', source_url: 'https://www.peraturan.go.id/files/permenkes-no-6-tahun-2024.pdf'}] AS row
MATCH (r:Regulation {id: row.reg_id})
MERGE (p:Provision {id:row.id})
SET p.citation=row.ref, p.source_url=row.source_url
MERGE (r)-[:HAS_PROVISION]->(p);

UNWIND [{id: 'N01', parent: 'N01', reg_id: 'R01', provision_id: 'R01::Pasal 18 ayat (2)', kind: 'WEWENANG_KONSTITUSIONAL', modality: 'HAK_MENGATUR', action: 'MENGATUR_MENGURUS', paraphrase: 'Pemerintahan daerah provinsi, kabupaten, dan kota mengatur serta mengurus sendiri urusan pemerintahannya berdasarkan asas otonomi dan tugas pembantuan.', validation_status: 'TEKS_DIVERIFIKASI'}, {id: 'N02', parent: 'N02', reg_id: 'R01', provision_id: 'R01::Pasal 18A ayat (1)', kind: 'ATURAN_HUBUNGAN', modality: 'DIATUR_UU', action: 'MENGATUR_HUBUNGAN_WEWENANG', paraphrase: 'Hubungan kewenangan antara pusat dan pemerintahan daerah serta antartingkat daerah diatur dengan undang-undang.', validation_status: 'TEKS_DIVERIFIKASI'}, {id: 'N03', parent: 'N03', reg_id: 'R01', provision_id: 'R01::Pasal 18A ayat (2)', kind: 'PRINSIP_KONSTITUSIONAL', modality: 'ADIL_SELARAS', action: 'MENGATUR_HUBUNGAN_PELAYANAN', paraphrase: 'Hubungan keuangan dan pelayanan umum pusat-daerah diatur dan dilaksanakan secara adil serta selaras berdasarkan undang-undang.', validation_status: 'TEKS_DIVERIFIKASI'}, {id: 'N04', parent: 'N04', reg_id: 'R01', provision_id: 'R01::Pasal 28H ayat (1)', kind: 'HAK_KONSTITUSIONAL', modality: 'BERHAK', action: 'MEMPEROLEH_PELAYANAN_KESEHATAN', paraphrase: 'Setiap orang mempunyai hak konstitusional untuk memperoleh pelayanan kesehatan, di samping hak lain yang diatur pada ayat sama.', validation_status: 'TEKS_DIVERIFIKASI'}, {id: 'N05', parent: 'N05', reg_id: 'R01', provision_id: 'R01::Pasal 34 ayat (3)', kind: 'TANGGUNG_JAWAB_NEGARA', modality: 'BERTANGGUNG_JAWAB', action: 'MENYEDIAKAN_FASILITAS', paraphrase: 'Negara bertanggung jawab atas penyediaan fasilitas pelayanan kesehatan dan pelayanan umum yang layak.', validation_status: 'TEKS_DIVERIFIKASI'}, {id: 'N06', parent: 'N06', reg_id: 'R02', provision_id: 'R02::Pasal 12 ayat (1) huruf b', kind: 'KLASIFIKASI_URUSAN', modality: 'DIKLASIFIKASIKAN', action: 'MENETAPKAN_KESEHATAN_URUSAN_DASAR', paraphrase: 'Kesehatan ditempatkan sebagai salah satu urusan pemerintahan wajib yang berkaitan dengan pelayanan dasar.', validation_status: 'TEKS_DIVERIFIKASI'}, {id: 'N07a', parent: 'N07', reg_id: 'R02', provision_id: 'R02::Pasal 18 ayat (1)', kind: 'PRIORITAS_DAN_STANDAR', modality: 'WAJIB_BERPEDOMAN', action: 'MEMPRIORITASKAN_URUSAN_DASAR', paraphrase: 'Memprioritaskan urusan wajib yang berkaitan dengan pelayanan dasar.', validation_status: 'TEKS_DIVERIFIKASI'}, {id: 'N07b', parent: 'N07', reg_id: 'R02', provision_id: 'R02::Pasal 18 ayat (2)', kind: 'PRIORITAS_DAN_STANDAR', modality: 'WAJIB_BERPEDOMAN', action: 'BERPEDOMAN_SPM_PUSAT', paraphrase: 'Pelayanan dasar wajib berpedoman pada SPM yang ditetapkan oleh Pemerintah Pusat.', validation_status: 'TEKS_DIVERIFIKASI'}, {id: 'N08a', parent: 'N08', reg_id: 'R03', provision_id: 'R03::Pasal 15', kind: 'KEBIJAKAN_DAERAH_DAN_NSPK', modality: 'DAPAT', action: 'MENETAPKAN_KEBIJAKAN_DAERAH', paraphrase: 'Pemerintah daerah dapat menetapkan kebijakan pembangunan kesehatan daerah.', validation_status: 'TEKS_DIVERIFIKASI'}, {id: 'N08b', parent: 'N08', reg_id: 'R03', provision_id: 'R03::Pasal 15', kind: 'KEBIJAKAN_DAERAH_DAN_NSPK', modality: 'WAJIB', action: 'MENGACU_NSPK_PUSAT', paraphrase: 'Kebijakan daerah wajib mengacu pada NSPK pembangunan kesehatan yang ditetapkan pusat.', validation_status: 'TEKS_DIVERIFIKASI'}, {id: 'N09', parent: 'N09', reg_id: 'R03', provision_id: 'R03::Pasal 19 ayat (2) huruf e', kind: 'FUNGSI_PUSAT', modality: 'MELAKUKAN', action: 'MENETAPKAN_STANDAR_PELAYANAN_KESEHATAN', paraphrase: 'Pemerintah pusat menjalankan fungsi menetapkan standar pelayanan kesehatan.', validation_status: 'TEKS_DIVERIFIKASI'}, {id: 'N10', parent: 'N10', reg_id: 'R03', provision_id: 'R03::Pasal 19 ayat (3) huruf b', kind: 'FUNGSI_DAERAH', modality: 'MELAKUKAN', action: 'MERENCANAKAN_MENGELOLA_MEMANTAU_SUPERVISI_EVALUASI', paraphrase: 'Pemerintah daerah melakukan perencanaan, pengelolaan, pemantauan, supervisi, dan evaluasi program kesehatan.', validation_status: 'TEKS_DIVERIFIKASI'}, {id: 'N11a', parent: 'N11', reg_id: 'R07', provision_id: 'R07::Pasal 21 ayat (1)', kind: 'TANGGUNG_JAWAB_DAN_PARTISIPASI', modality: 'BERTANGGUNG_JAWAB', action: 'MENGELOLA_KESEHATAN', paraphrase: 'Pusat, provinsi, kabupaten/kota, dan desa bertanggung jawab menyelenggarakan pengelolaan kesehatan menurut kewenangan.', validation_status: 'TEKS_DIVERIFIKASI'}, {id: 'N11b', parent: 'N11', reg_id: 'R07', provision_id: 'R07::Pasal 21 ayat (1)', kind: 'TANGGUNG_JAWAB_DAN_PARTISIPASI', modality: 'BERTANGGUNG_JAWAB', action: 'MENDORONG_PARTISIPASI', paraphrase: 'Pusat, provinsi, kabupaten/kota, dan desa mendorong partisipasi masyarakat menurut kewenangan.', validation_status: 'TEKS_DIVERIFIKASI'}, {id: 'N12', parent: 'N12', reg_id: 'R07', provision_id: 'R07::Pasal 22 ayat (1)', kind: 'JAMINAN_MUTU_AKSES', modality: 'MEMASTIKAN', action: 'MEMASTIKAN_AKSES_MUTU', paraphrase: 'Pemerintah pusat, provinsi, dan kabupaten/kota memastikan akses, cakupan, pemerataan, keamanan, mutu, dan keterjangkauan layanan kesehatan.', validation_status: 'TEKS_DIVERIFIKASI'}, {id: 'N13', parent: 'N13', reg_id: 'R04', provision_id: 'R04::Pasal 2', kind: 'PRINSIP_SPM', modality: 'PRINSIP', action: 'MENERAPKAN_PRINSIP_SPM', paraphrase: 'Penetapan dan penerapan SPM harus mengikuti sejumlah prinsip termasuk kesesuaian kewenangan dan keterjangkauan.', validation_status: 'TEKS_DIVERIFIKASI'}, {id: 'N14', parent: 'N14', reg_id: 'R04', provision_id: 'R04::Pasal 6 ayat (2) huruf b', kind: 'KLASIFIKASI_LAYANAN', modality: 'MENCAKUP', action: 'MENCAKUP_LAYANAN', paraphrase: 'SPM kesehatan provinsi memasukkan pelayanan untuk penduduk dalam kondisi kejadian luar biasa tingkat provinsi.', validation_status: 'TEKS_DIVERIFIKASI'}, {id: 'N15', parent: 'N15', reg_id: 'R04', provision_id: 'R04::Pasal 6 ayat (3) huruf a', kind: 'KLASIFIKASI_LAYANAN', modality: 'MENCAKUP', action: 'MENCAKUP_LAYANAN', paraphrase: 'SPM kesehatan kabupaten/kota memasukkan pelayanan kesehatan ibu hamil.', va