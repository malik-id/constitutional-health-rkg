d: 'N16', relation: 'DASAR_TAHAPAN_PENERAPAN', evidence_level: 'E2', source_reference: 'PP 2 Pasal 16; Permendagri 59 Pasal 4', rationale: 'Delegasi penerapan SPM melandasi aturan tahapan Permendagri.', validation: 'PERIKSA_DOKUMEN'}, {id: 'K22', from_id: 'N12', to_id: 'S06', relation: 'MUTU_DAN_SUMBER_DAYA', evidence_level: 'E2', source_reference: 'Perpres 13 Pasal 22(1) dan Pasal 21(4)', rationale: 'Pemerataan mutu pelayanan terkait tanggung jawab penyediaan sumber daya daerah.', validation: 'PERIKSA_DOKUMEN'}, {id: 'K23', from_id: 'N01', to_id: 'S01', relation: 'KONTEKS_OTONOMI_KONSTITUSI', evidence_level: 'E2', source_reference: 'UUD Pasal 18(2) dan Pasal 18(5)', rationale: 'Kewenangan mengurus urusan daerah terkait prinsip otonomi seluas-luasnya dengan pengecualian.', validation: 'PERIKSA_DOKUMEN'}, {id: 'K24', from_id: 'N15', to_id: 'N18', relation: 'LANDASAN_JENIS_DAN_KEWAJIBAN', evidence_level: 'E2', source_reference: 'PP 2 Pasal 6(3)a; Permenkes 6 Pasal 2(1)', rationale: 'Jenis SPM kabupaten/kota dipadukan dengan kewajiban implementasi daerah.', validation: 'PERIKSA_DOKUMEN'}] AS row
