// Pemeriksaan jumlah setelah import
MATCH (n:Norm) RETURN count(n) AS total_norms;
MATCH (r:Regulation) RETURN count(r) AS total_regulasi;
MATCH ()-[e:RELATED_NORM]->() RETURN count(e) AS total_relasi_kandidat;